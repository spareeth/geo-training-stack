{
  "sector": "Health",
  "process": "accessibility",
  "title": "Health facility catchment gaps",
  "question": "How many people live more than 10 km from a health facility, and where?",
  "inputs": {
    "facilities": {
      "osm": "health"
    },
    "population": {
      "collection": "worldpop",
      "catalog": "local",
      "asset": "data",
      "counts": true
    },
    "limit_m": 10000,
    "resolution": 200
  },
  "follow_up": {
    "process": "suitability",
    "inputs": {
      "resolution": 200,
      "threshold": 0.7,
      "top_n": 5,
      "criteria": [
        {
          "name": "Far from health facilities",
          "source": {
            "osm": "health"
          },
          "rule": {
            "type": "linear",
            "min": 5000,
            "max": 15000,
            "direction": "higher"
          },
          "weight": 4
        },
        {
          "name": "Population density",
          "source": {
            "collection": "worldpop",
            "catalog": "local",
            "asset": "data",
            "counts": true
          },
          "rule": {
            "type": "linear",
            "min": 0,
            "max": 200,
            "direction": "higher"
          },
          "weight": 4
        },
        {
          "name": "Close to a road",
          "source": {
            "osm": "roads"
          },
          "rule": {
            "type": "linear",
            "min": 0,
            "max": 2000,
            "direction": "lower"
          },
          "weight": 2
        }
      ],
      "constraints": [
        {
          "source": {
            "collection": "esa-worldcover",
            "catalog": "planetary-computer",
            "asset": "map",
            "categorical": true
          },
          "classes": [
            80,
            90,
            95
          ]
        },
        {
          "source": {
            "collection": "jrc-gsw",
            "catalog": "planetary-computer",
            "asset": "occurrence"
          },
          "op": ">",
          "value": 10
        }
      ]
    }
  },
  "id": "health-catchment-gaps"
}