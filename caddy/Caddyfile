{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# JupyterHub has its own login (shared password), so no basic auth here.
	handle /lab* {
		reverse_proxy jupyterhub:8000
	}

	handle {
		basic_auth {
			{$TRAINEE_USER} {$TRAINEE_PASSWORD_HASH}
		}

		handle_path /tiles/* {
			reverse_proxy titiler:8000
		}
		# GeoLibre plugin: install from https://DOMAIN/plugins/server-analysis/plugin.json
		handle_path /plugins/* {
			root * /srv/plugins
			file_server
		}
		handle_path /outputs/* {
			root * /srv/outputs
			file_server
		}
		handle /processes-api* {
			reverse_proxy pygeoapi:80
		}
		# Course catalogue, read-only: writes go through 127.0.0.1:8082 on the server.
		@stac_write {
			path /stac*
			not method GET HEAD OPTIONS
			not path /stac/search
		}
		handle @stac_write {
			respond "Catalogue is read-only" 405
		}
		handle /stac* {
			reverse_proxy stac-api:8080
		}
		reverse_proxy geolibre:80
	}
}
