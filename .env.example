# Copy to .env and fill in. Never commit .env.
DOMAIN=geo.example.org
ACME_EMAIL=admin@example.org
# Shared trainee login for the web apps (Caddy basic auth).
TRAINEE_USER=trainee
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'yourpassword'
# Keep the single quotes: Compose would otherwise expand each $ in the hash.
TRAINEE_PASSWORD_HASH=''
# Plain shared password trainees type into JupyterHub (any username, this password).
JUPYTER_SHARED_PASSWORD=
# Course catalogue (stac-fastapi-pgstac). Database password: any long random string.
STAC_DB_PASSWORD=
# STAC API base used by processes to resolve item ids (internal address, no change needed)
STAC_API_URL=http://stac-api:8080/stac
# Absolute host path of ./data, mounted read-only into every notebook
HOST_DATA_DIR=/opt/geo-training-stack/data
# Absolute host path of this repo (presets, examples and the MCDA library are mounted into notebooks)
HOST_REPO_DIR=/opt/geo-training-stack

# Copernicus Data Space Ecosystem S3 keys, server-side only (https://eodata-s3keysmanager.dataspace.copernicus.eu/)
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
