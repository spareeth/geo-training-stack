# Copy to .env. Never commit .env.
# Public address of this server (DNS A record pointing here). Caddy gets the HTTPS certificate.
SIDECAR_SITE=sidecar.example.org
ACME_EMAIL=admin@example.org
# Shared code participants type into the plugin. Long and random; change it per course.
ACCESS_CODE=
# The GeoLibre web app allowed to call this server.
ALLOWED_ORIGIN=https://web.geolibre.app
MAX_UPLOAD_MB=500
